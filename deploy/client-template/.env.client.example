CLIENT_SLUG=cliente-x
COMPOSE_PROJECT_NAME=magazzino-cliente-x
CLIENT_DOMAIN=cliente-x.magazzinosolidale.it
WEB_HOST_PORT=8083

DATA_ROOT=/data/magazzino-clienti
SOURCE_REPO_DIR=/opt/magazzino-sorgente/Magazzino-Solidale

POSTGRES_DB=magazzino_cliente_x
POSTGRES_USER=magazzino_cliente_x
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql://magazzino_cliente_x:CHANGE_ME_STRONG_PASSWORD@db:5432/magazzino_cliente_x
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
APP_ORIGINS=https://cliente-x.magazzinosolidale.it
APP_BASE_URL=https://cliente-x.magazzinosolidale.it
PUBLIC_APP_URL=https://cliente-x.magazzinosolidale.it

NODE_ENV=production

# Privacy-safe: il provider pubblico resta disabilitato finché non viene
# autorizzato esplicitamente. Un NOMINATIM_BASE_URL custom/self-hosted funziona
# anche lasciando questo flag a false.
MAPS_PUBLIC_GEOCODING_ALLOWED=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MagazzinoSolidale/2.1 (+https://magazzino.angeliinmoto.it)

MAPS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPS_TILE_ATTRIBUTION=© OpenStreetMap contributors
